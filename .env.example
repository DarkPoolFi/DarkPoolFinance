# Server only unless prefixed VITE_. Copy to .env.local (gitignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Robinhood Chain: mainnet 4663 https://rpc.mainnet.chain.robinhood.com, testnet 46630 https://rpc.testnet.chain.robinhood.com
DARKPOOL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
DARKPOOL_CHAIN_ID=4663
DARKPOOL_VAULT_ADDRESS=
DARKPOOL_OPERATOR_KEY=
# Chainlink ETH/USD on 4663 (8 decimals, 24h heartbeat, 0.5% deviation)
DARKPOOL_ETH_USD_FEED=0x78f3556b67e17df817d51ef5a990cdaf09e8d3a9
CRON_SECRET=
RH_ASSETS_URL=

# Funding leg (M3b)
DARKPOOL_RESERVE_ADDRESS=
DARKPOOL_RESERVE_KEY=
DARKPOOL_HOLDING_ENC_KEY=
DARKPOOL_GAS_KEY=
DARKPOOL_HOP_API_URL=
DARKPOOL_HOP_API_KEY=
DARKPOOL_HOP_NETWORK=HOOD

# Telegram bot (telegram_tech_update.md TG-0). Token from @BotFather; the secret is any 16-256 chars of A-Za-z0-9_-.
# Run scripts/telegram-setup.ts once after setting them. TELEGRAM_ALERT_CHAT_ID also sends operator alerts there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALERT_CHAT_ID=
